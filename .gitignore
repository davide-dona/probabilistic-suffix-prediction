# Python-generated files
__pycache__/
*.py[oc]
outputs/
CLAUDE.md
*DS_Store

# Published models, fetched from the Hugging Face repo rather than committed
pretrained/

# Pinned runs, moved out of outputs/ by scripts/pin.py so a wipe of it can't touch them
pinned/


# Notes on things worth trying, kept out of the repo until one of them is actually done
ideas/

# Virtual environments
.venv


# Preprocessed datasets
data/
!original.csv


# Dataset configs staged for a batch training run, kept out of the repo like the runs they
# produce; config/queue/README.md is what makes the directory exist on a fresh clone
config/queue/*.yaml
config/queue/*.running
config/queue/*.failed

# Temporary scripts
tmp/

# Notes directory
notes/