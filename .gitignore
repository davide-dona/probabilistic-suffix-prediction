outputs/
pinned/


# Notes on things worth trying, kept out of the repo until one of them is actually done
ideas/

# Virtual environments
.venv


# Preprocessed datasets
data/*
!data/*/
data/*/*
!data/*/original.csv


# Temporary scripts
tmp/

# Notes directory
notes/
