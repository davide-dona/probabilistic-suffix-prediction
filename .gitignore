# Python-generated files
__pycache__/
*.py[oc]
outputs/
*DS_Store

# W&B's local run cache; a run's data lives in the cloud project once synced
wandb/

# The local doc set: CLAUDE.md and the topic docs it points at
CLAUDE.md
.claude/docs/

# Published models, fetched from the Hugging Face repo rather than committed
pretrained/

# Runs pinned by hand, moved out of outputs/ so a wipe of it cannot touch them. Mirrors
# outputs/ own layout.
pinned/


# Notes on things worth trying, kept out of the repo until one of them is actually done
ideas/

# Virtual environments
.venv


# Preprocessed datasets
data/*
!data/*/
data/*/*
!data/*/original.csv


# Temporary scripts
tmp/

# Notes directory
notes/
